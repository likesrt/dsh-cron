{
  "name": "dsh-cron",
  "version": "0.1.0",
  "description": "定时任务：脚本或模型执行的定时作业，侧边栏内嵌管理页面，任务数据按工作区隔离。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likesrt/dsh-cron.git"
  },
  "homepage": "https://github.com/likesrt/dsh-cron#readme",
  "bugs": {
    "url": "https://github.com/likesrt/dsh-cron/issues"
  }
}
